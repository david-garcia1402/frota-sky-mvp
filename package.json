{
  "name": "frota-sky",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "cf:dev": "npm run build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply frota-sky-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply frota-sky-db --remote",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test --test-concurrency=1 tests/billing.test.mjs tests/checkout-flow.test.mjs",
    "check": "node --check worker/index.js && node --check worker/lib/billing.js && npm test && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.5",
    "wrangler": "^4.40.0"
  }
}
